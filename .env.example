# ==========================================
# StudyNow Environment Variables Configuration
# ==========================================

# Port for the Node server (default: 3000)
PORT=3000
NODE_ENV=development

# ------------------------------------------
# 1. Supabase Database (PostgreSQL)
# ------------------------------------------
# Obtain from: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Works with both direct connection (port 5432) and Transaction Pooled mode (port 6543)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# ------------------------------------------
# 2. Supabase Auth & Storage
# ------------------------------------------
# Obtain from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://[YOUR-PROJECT-ID].supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."
SUPABASE_STORAGE_BUCKET="notes-files"

# Frontend variables for Google OAuth via Supabase
VITE_SUPABASE_URL="https://[YOUR-PROJECT-ID].supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOi..."

# ------------------------------------------
# 3. Google Gemini API (Multimodal AI & Q&A)
# ------------------------------------------
# Obtain from: https://aistudio.google.com/app/apikey (Free tier available)
GEMINI_API_KEY="AIzaSy..."
GEMINI_MODEL="gemini-2.0-flash"

# ------------------------------------------
# 4. Session Security
# ------------------------------------------
JWT_SECRET="studynow-super-secret-jwt-key-replace-in-production"
